{
  "name": "miro-workflows",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "description": "Production-grade Miro command center: React dashboard, Node API, custom MCP server (20 tools), typed contracts, three-agent planning harness, OAuth device flow, Prometheus metrics, full Docker stack.",
  "packageManager": "pnpm@10.11.1",
  "homepage": "https://github.com/Alexi5000/miro-workflows#readme",
  "bugs": {
    "url": "https://github.com/Alexi5000/miro-workflows/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexi5000/miro-workflows.git"
  },
  "scripts": {
    "dev": "pnpm run seed && pnpm run dev:api",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "seed": "tsx server/db/seed.ts",
    "build": "pnpm run build:web && pnpm run build:api && pnpm run mcp:build",
    "build:web": "vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate_setup.ts",
    "smoke": "tsx scripts/smoke_api.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:ui": "vitest run --config vitest.dom.config.ts",
    "test:all": "vitest run --config vitest.config.ts && vitest run --config vitest.dom.config.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "contracts:build": "tsx scripts/build_contracts.ts",
    "contracts:check": "tsx scripts/check_contract_versions.ts",
    "bench": "tsx scripts/bench.ts",
    "openapi:build": "tsx scripts/generate_openapi.ts",
    "agent:run": "tsx src/agents/cli.ts",
    "mcp:dev": "cd miro-custom-mcp && pnpm run dev",
    "mcp:build": "cd miro-custom-mcp && pnpm run build",
    "mcp:test": "cd miro-custom-mcp && pnpm test",
    "ci": "pnpm run typecheck && pnpm run contracts:check && pnpm run test && pnpm run test:ui && pnpm run smoke && pnpm run validate",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v"
  },
  "keywords": [
    "miro",
    "mcp",
    "model-context-protocol",
    "workflows",
    "collaboration",
    "react",
    "typescript",
    "sqlite",
    "nodejs"
  ],
  "author": "TechTide",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "pg": "^8.22.0",
    "react": "latest",
    "react-dom": "latest",
    "sql.js": "^1.13.0",
    "typescript": "latest",
    "vite": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.19",
    "@types/pg": "^8.20.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^2.1.9",
    "happy-dom": "^15.11.7",
    "jsdom": "^25.0.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.4",
    "vitest": "^2.1.9",
    "zod-to-json-schema": "^3.25.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
