{
  "name": "miro-workflows",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Production-ready Miro workflow operations dashboard with TypeScript, a Node API, SQLite schemas, and MCP tooling.",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "pnpm run seed && pnpm run dev:api",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "seed": "tsx server/db/seed.ts",
    "build": "pnpm run build:web && pnpm run build:api && pnpm run mcp:build",
    "build:web": "vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate_setup.ts",
    "smoke": "tsx scripts/smoke_api.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "contracts:build": "tsx scripts/build_contracts.ts",
    "contracts:check": "tsx scripts/check_contract_versions.ts",
    "mcp:dev": "cd miro-custom-mcp && pnpm run dev",
    "mcp:build": "cd miro-custom-mcp && pnpm run build",
    "mcp:test": "cd miro-custom-mcp && pnpm test",
    "ci": "pnpm run typecheck && pnpm run contracts:check && pnpm run test && pnpm run smoke && pnpm run validate",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v"
  },
  "keywords": [
    "miro",
    "mcp",
    "model-context-protocol",
    "workflows",
    "collaboration",
    "react",
    "typescript",
    "sqlite",
    "nodejs"
  ],
  "author": "TechTide",
  "license": "MIT",
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sql.js": "^1.13.0",
    "typescript": "latest",
    "vite": "latest",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.19",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^2.1.9",
    "supertest": "^7.2.2",
    "tsx": "^4.19.4",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
