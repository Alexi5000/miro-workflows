{
  "name": "miro-custom-mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "Custom Miro MCP server with full API control for board automation workflows.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench": "tsx scripts/bench.ts"
  },
  "keywords": [
    "mcp",
    "miro",
    "model-context-protocol",
    "nodejs",
    "typescript"
  ],
  "author": "TechTide",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
