# Dockerfile.api — multi-stage build for the Node HTTP API.
#   stage1 (build): install + tsc → /app/dist/server
#   stage2 (run): node:20-alpine runtime as non-root
FROM node:26-alpine AS build
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
COPY miro-custom-mcp/package.json miro-custom-mcp/pnpm-lock.yaml* ./miro-custom-mcp/
RUN corepack enable && corepack prepare pnpm@10.11.1 --activate
RUN pnpm install --frozen-lockfile
COPY tsconfig.json tsconfig.server.json ./
COPY src ./src
COPY server ./server
COPY shared ./shared
COPY scripts ./scripts
RUN pnpm run build:api

FROM node:26-alpine AS run
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8787
ENV DATABASE_URL=sqlite:///data/miro-workflows.sqlite
COPY --from=build /app/package.json /app/pnpm-lock.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist/server ./dist/server
COPY --from=build /app/src ./src
COPY --from=build /app/server/db/schema.sql ./server/db/schema.sql
COPY --from=build /app/shared ./shared
RUN addgroup -S app && adduser -S app -G app && mkdir -p /data && chown -R app:app /data
RUN chown -R app:app /app
USER app
EXPOSE 8787
VOLUME ["/data"]
# Use `node -e` because `node:20-alpine` ships without `wget`.
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:8787/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/server/server/index.js"]
