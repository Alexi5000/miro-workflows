# Dockerfile.mcp — multi-stage build for the standalone MCP server.
FROM node:26-alpine AS build
WORKDIR /app
COPY miro-custom-mcp/package.json miro-custom-mcp/pnpm-lock.yaml* ./
COPY shared ../shared
RUN corepack enable && corepack prepare pnpm@10.11.1 --activate
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY miro-custom-mcp/tsconfig.json ./
COPY miro-custom-mcp/src ./src
COPY shared ../shared
RUN pnpm run build

FROM node:26-alpine AS run
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/package.json /app/pnpm-lock.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
RUN addgroup -S app && adduser -S app -G app
RUN chown -R app:app /app
USER app
# MCP runs over stdio; no HTTP port.
CMD ["node", "dist/index.js"]
