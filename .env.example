# Miro Workflows environment template
# The application runs in demo mode without secrets by default.

# API
PORT=8787
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=data/miro-workflows.sqlite

# Provider mode: demo | miro
MIRO_PROVIDER_MODE=demo

# Optional live Miro REST token. Never commit real token values.
MIRO_ACCESS_TOKEN=

# Optional future OAuth values for connected workspace mode.
MIRO_CLIENT_ID=
MIRO_CLIENT_SECRET=
MIRO_REDIRECT_URL=http://127.0.0.1:8787/auth/miro/callback

# Optional deployed API origin for the Vite client.
VITE_API_BASE_URL=
