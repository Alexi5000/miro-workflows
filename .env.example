# Miro Workflows environment template
# The application runs in demo mode without secrets by default.

# API
PORT=8787
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=data/miro-workflows.sqlite

# Provider mode: demo | miro
MIRO_PROVIDER_MODE=demo

# Optional live Miro REST token. Never commit real token values.
MIRO_ACCESS_TOKEN=

# Optional Miro OAuth (device authorization flow) for connected workspace mode.
# Leave MIRO_OAUTH_CLIENT_ID empty (or set MIRO_OAUTH_DEMO=1) to use the demo OAuth client.
MIRO_OAUTH_CLIENT_ID=
MIRO_OAUTH_CLIENT_SECRET=
# Optional overrides (leave commented to use the defaults):
# MIRO_OAUTH_BASE_URL=https://api.miro.com/v1
# MIRO_OAUTH_DEMO=1

# AES-256-GCM key for stored OAuth tokens: 32 bytes, base64.
# Generate with: openssl rand -base64 32
# Required when NODE_ENV=production; a dev fallback key is used otherwise.
MIRO_TOKEN_ENCRYPTION_KEY=

# Optional deployed API origin for the Vite client.
VITE_API_BASE_URL=
